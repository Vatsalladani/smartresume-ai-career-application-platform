{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/ats-resume-checker",
      "destination": "/frontend/job-match.html"
    },
    {
      "source": "/resume-builder-for-engineers",
      "destination": "/frontend/resume-builder.html"
    },
    {
      "source": "/faang-resume-guide",
      "destination": "/frontend/interview-prep.html"
    },
    {
      "source": "/app",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
