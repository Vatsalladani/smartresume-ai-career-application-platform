{
  "manifest_version": 3,
  "name": "SmartApply Copilot - SmartResume.ai",
  "version": "1.0.0",
  "description": "Evidence-grounded job application copilot for SmartResume.ai. Autofill verified details and tailor applications accurately.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartApply Copilot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.naukri.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.workday.com/*",
        "*://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
