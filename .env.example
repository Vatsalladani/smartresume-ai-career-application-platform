APP_NAME=SmartResume.ai
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resume_saas_db
JWT_SECRET_KEY=dev-secret-change-before-production-64-characters-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000
FRONTEND_URL=http://127.0.0.1:3000
MAX_REQUEST_SIZE_BYTES=12000000
UPLOAD_MAX_BYTES=10000000

# Granular Rate Limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AI_REQUESTS=15
RATE_LIMIT_AI_WINDOW_SECONDS=60

# AI Configuration (Gemini 3.6 Flash / 3.5 Flash-Lite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# Payment Architecture (test, live, mock)
PAYMENTS_MODE=mock
PAYMENT_MODE=test
TEST_UPI_ID=ladanivatsal8892@oksbi
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Pricing Overrides (INR Base)
PLAN_FREE_PRICE_INR=0
PLAN_SINGLE_EXPORT_PRICE_INR=1
PLAN_PRO_MONTHLY_PRICE_INR=79
PLAN_PRO_ANNUAL_PRICE_INR=699
CREDIT_PACK_10_PRICE_INR=29
CREDIT_PACK_20_PRICE_INR=49
CREDIT_PACK_50_PRICE_INR=99

# Usage Quotas Defaults
FREE_QUOTA_FIT_ANALYSES_PER_MONTH=2
FREE_QUOTA_TAILORED_VERSIONS_PER_MONTH=2
FREE_QUOTA_EXPORTS_PER_MONTH=2
FREE_QUOTA_TEMPLATES_ALLOWED=2
PRO_QUOTA_FIT_ANALYSES_PER_MONTH=50
PRO_QUOTA_TAILORED_VERSIONS_PER_MONTH=30
PRO_QUOTA_EXPORTS_PER_MONTH=20
PRO_QUOTA_TEMPLATES_ALLOWED=4

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:3000
